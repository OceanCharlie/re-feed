<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonicalize: Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.refeed-indonesia\.com$ [NC]
  RewriteRule ^(.*)$ https://refeed-indonesia.com/$1 [L,R=301]

  # Redirect robot.txt (typo/singular) to robots.txt (standard SEO)
  RewriteRule ^robot\.txt$ /robots.txt [L,R=301]

  # If requested resource exists as a file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Check if requested URL + .html exists (e.g. /behind-refeed -> /behind-refeed.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Check if requested URL / index.html exists
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# Custom 404 Page
ErrorDocument 404 /404.html

# Caching & Compression
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
